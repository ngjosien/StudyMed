{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:default",
    "opener:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/**"
        }
      ]
    }
  ]
}
